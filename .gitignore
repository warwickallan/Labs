# Secrets and authentication material — never commit
.env
.env.*
*.pem
*.key
*.pfx
*credentials*
*secrets*

# Browser / runtime artefacts
*.har
browser-profile/
session-storage/
cookies*

# Studio local runtime data (instance-specific / customer-specific /
# session material — never publishable). The app creates these on demand.
apps/concerto-studio/data/
apps/concerto-studio/snapshots/
apps/concerto-studio/receipts/
# Customer PROJECT data (instance URLs, configuration evidence, findings,
# change receipts for real customers) must never enter this PUBLIC repo.
apps/concerto-studio/projects/

# Local scratch and OS noise
scratch/
tmp/
Thumbs.db
.DS_Store
__pycache__/
*.pyc
